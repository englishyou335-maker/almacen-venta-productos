# ------------------------------------------------------------------
# LOCAL (docker compose) — copia este archivo como .env
# ------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=test
DB_USER=almacen
DB_PASS=almacen_secret

# ------------------------------------------------------------------
# PRODUCCIÓN (Render + TiDB Cloud) — solo DOS variables de entorno
# ------------------------------------------------------------------
# DB_URL=mysql://USUARIO:PASSWORD@HOST:4000/test
# DATABASE_URL se acepta como alias. El CA del sistema se usa automáticamente.
#
# Cloudinary es opcional: una sola variable con la cadena completa.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Sin ella las imágenes usan placeholder.
# Legado (también funciona): CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY
# y CLOUDINARY_API_SECRET por separado.
